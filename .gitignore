.DS_Store
*.pyc
__pycache__
prefs.plist
lib

# sandbox/ is scratch space, EXCEPT the database generator: source/whowaswhen is
# built from it, and leaving it untracked is how a v0.2-era build of it got
# shipped in 0.4 with nobody able to tell. Source is tracked; the binary is not.
sandbox/*
!sandbox/database generator/
sandbox/database generator/*
!sandbox/database generator/go-whowaswhen/
sandbox/database generator/go-whowaswhen/whowaswhen

# Secrets & local config for sheet-maintenance / tools (never commit)
tools/.venv/
sheet-maintenance/.venv/
sheet-maintenance/config.yaml
tools/config.yaml
**/service-account*.json
**/*credentials*.json
# App Store Connect API private keys — never commit (repo is public)
**/*.p8
**/AuthKey_*

# iOS companion app (Xcode project is generated from project.yml via XcodeGen)
ios/.build/
ios/WhoWasWhen.xcodeproj/
ios/DerivedData/
**/xcuserdata/
ios/build/

# Personal feature brain-dump / wishlist (local only)
ios/new-features.md

# Built at package time by pkg/package-release.sh; source/ is the live
# workflow folder, so a zip left here is deleted by the next local run.
source/whoWasWhen.zip
